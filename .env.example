# Copy to .env.local for local dev, and add these to your Vercel project env vars for production.
# Get them from your Supabase project dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service role key — server-side only. Used by /api/admin-save-results to bypass RLS
# when writing the actual_results singleton and rescoring every bracket in batch.
# NEVER expose this client-side. Mark as "Secret" in Vercel.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin email(s) that can enter actual results on /admin. Comma-separated.
ADMIN_EMAILS=club33dis@gmail.com

# UTC kickoff of the first group match. Brackets lock at this moment.
# 2026 World Cup opener: Mexico vs. South Africa, Estadio Azteca, June 11 2026.
NEXT_PUBLIC_LOCK_AT_ISO=2026-06-11T22:00:00Z

# Shared secret for manual /api/cron/sync-results calls (optional).
# Vercel Cron calls the endpoint directly and doesn't need this.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
